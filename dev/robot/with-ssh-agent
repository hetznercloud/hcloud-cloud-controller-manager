#!/usr/bin/env bash

set -ueo pipefail

# required for ssh-copy-id
mkdir -p ~/.ssh

# start ssh agent
eval "$(ssh-agent -s)"

# ensure ssh agent is cleaned on exit
# shellcheck disable=SC2064
trap "kill '$SSH_AGENT_PID'" EXIT

# load robot ssh key
ssh-add - <<< "$ROBOT_SSH_KEY"

# run the wrapped command
"$@"
